{
  "name": "omniengine",
  "version": "0.1.0",
  "description": "Node.js bindings for OmniEngine: a NaN-boxed, garbage-collection-free expression engine behind a C ABI, reached through koffi.",
  "keywords": [
    "omni",
    "omniengine",
    "language",
    "interpreter",
    "ffi",
    "embed",
    "koffi",
    "native"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Tamzid Abdur Rahman (fahim5536)",
  "homepage": "https://github.com/fahim5536/OmniEngine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fahim5536/OmniEngine.git",
    "directory": "sdks/nodejs"
  },
  "bugs": "https://github.com/fahim5536/OmniEngine/issues",
  "main": "index.js",
  "exports": {
    ".": {
      "require": "./index.js",
      "default": "./index.js"
    },
    "./bindings": "./lib/bindings.js",
    "./discover": "./lib/discover.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "native/",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:engine": "cargo build -p omni-ffi",
    "postinstall": "node scripts/postinstall.js",
    "prepack": "node scripts/prepack.js",
    "pack:check": "node scripts/prepack.js --require-native",
    "test": "node --test tests/",
    "test:verbose": "node --test --test-reporter=spec tests/"
  },
  "optionalDependencies": {
    "koffi": "^3.3.6"
  },
  "dependencies": {},
  "devDependencies": {},
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
